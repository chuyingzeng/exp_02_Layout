<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 顶部绿色标题栏 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#009688"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:text="ConstraintLayoutTest"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Input -->
    <TextView
        android:id="@+id/tvInput"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:text="Input"
        android:textColor="#888888"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <!-- 结果 -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:background="#D5D1A6"
        android:gravity="center_vertical|end"
        android:paddingEnd="8dp"
        android:text="0.0"
        android:textColor="#666666"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/tvInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp" />

    <!-- 第一行 -->

    <Button
        android:id="@+id/btn7"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="7"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn8"
        android:layout_marginTop="38dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn8"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="8"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@id/btn7"
        app:layout_constraintEnd_toStartOf="@id/btn9"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn9"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="9"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@id/btn8"
        app:layout_constraintEnd_toStartOf="@id/btnDivide"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnDivide"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="÷"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@id/btn9"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp" />

    <!-- 第二行 -->

    <Button
        android:id="@+id/btn4"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="4"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn5"
        android:layout_marginTop="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn5"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="5"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@id/btn4"
        app:layout_constraintEnd_toStartOf="@id/btn6"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn6"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="6"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@id/btn5"
        app:layout_constraintEnd_toStartOf="@id/btnMultiply"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnMultiply"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="×"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@id/btn6"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp" />

    <!-- 第三行 -->

    <Button
        android:id="@+id/btn1"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="1"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn2"
        android:layout_marginTop="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn2"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="2"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@id/btn1"
        app:layout_constraintEnd_toStartOf="@id/btn3"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn3"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="3"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@id/btn2"
        app:layout_constraintEnd_toStartOf="@id/btnPlus"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnPlus"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@id/btn3"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp" />

    <!-- 第四行 -->

    <Button
        android:id="@+id/btnDot"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="."
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn0"
        android:layout_marginTop="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn0"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="0"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btnDot"
        app:layout_constraintStart_toEndOf="@id/btnDot"
        app:layout_constraintEnd_toStartOf="@id/btnEqual"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnEqual"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="="
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btnDot"
        app:layout_constraintStart_toEndOf="@id/btn0"
        app:layout_constraintEnd_toStartOf="@id/btnMinus"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnMinus"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="-"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/btnDot"
        app:layout_constraintStart_toEndOf="@id/btnEqual"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>