<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <!-- ================= 顶部三个图标 ================= -->

    <ImageView
        android:id="@+id/imgStation"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/space_station_icon"
        android:contentDescription="Space Stations"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgFlights"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />


    <ImageView
        android:id="@+id/imgFlights"
        android:layout_width="28dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/rocket_icon"
        android:contentDescription="Flights"

        app:layout_constraintStart_toEndOf="@id/imgStation"
        app:layout_constraintEnd_toStartOf="@id/imgRovers"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/imgRovers"
        android:layout_width="32dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/rover_icon"
        android:contentDescription="Rovers"

        app:layout_constraintStart_toEndOf="@id/imgFlights"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ================= 顶部文字 ================= -->

    <TextView
        android:id="@+id/tvStation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Space Stations"
        android:textColor="#777777"
        android:textSize="12sp"

        app:layout_constraintStart_toStartOf="@id/imgStation"
        app:layout_constraintEnd_toEndOf="@id/imgStation"
        app:layout_constraintTop_toBottomOf="@id/imgStation" />


    <TextView
        android:id="@+id/tvFlights"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Flights"
        android:textColor="#777777"
        android:textSize="12sp"

        app:layout_constraintStart_toStartOf="@id/imgFlights"
        app:layout_constraintEnd_toEndOf="@id/imgFlights"
        app:layout_constraintTop_toBottomOf="@id/imgFlights" />


    <TextView
        android:id="@+id/tvRovers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Rovers"
        android:textColor="#777777"
        android:textSize="12sp"

        app:layout_constraintStart_toStartOf="@id/imgRovers"
        app:layout_constraintEnd_toEndOf="@id/imgRovers"
        app:layout_constraintTop_toBottomOf="@id/imgRovers" />


    <!-- ================= DCA ================= -->

    <TextView
        android:id="@+id/tvDca"
        android:layout_width="130dp"
        android:layout_height="90dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="#2E7D32"
        android:gravity="center"
        android:text="DCA"
        android:textColor="#FFFFFF"
        android:textSize="16sp"

        app:layout_constraintEnd_toStartOf="@id/tvMars"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFlights" />


    <!-- ================= MARS ================= -->

    <TextView
        android:id="@+id/tvMars"
        android:layout_width="130dp"
        android:layout_height="90dp"
        android:background="#2E7D32"
        android:gravity="center"
        android:text="MARS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvDca"
        app:layout_constraintTop_toTopOf="@id/tvDca" />


    <!-- ================= 双向箭头 ================= -->
    <!--
        DCA 与 MARS 中间空隙为 24dp
        箭头宽度为 48dp
        所以箭头会向左右各覆盖约 12dp
    -->

    <ImageView
        android:id="@+id/imgDoubleArrow"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="#FFFFFF"
        android:contentDescription="Swap"
        android:elevation="10dp"
        android:padding="7dp"
        android:src="@drawable/double_arrows"

        app:layout_constraintBottom_toBottomOf="@id/tvDca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvDca" />


    <!-- ================= One Way ================= -->

    <TextView
        android:id="@+id/tvOneWay"
        android:layout_width="165dp"
        android:layout_height="38dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="18dp"
        android:background="#D66A00"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:text="One Way"
        android:textColor="#FFFFFF"
        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDca" />


    <!-- One Way 白色圆点 -->

    <View
        android:id="@+id/oneWayCircle"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/circle_white"

        app:layout_constraintBottom_toBottomOf="@id/tvOneWay"
        app:layout_constraintEnd_toEndOf="@id/tvOneWay"
        app:layout_constraintTop_toTopOf="@id/tvOneWay" />


    <!-- ================= Traveller ================= -->

    <TextView
        android:id="@+id/tvTraveller"
        android:layout_width="82.5dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="#D66A00"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="@id/tvOneWay"
        app:layout_constraintTop_toBottomOf="@id/tvOneWay" />


    <!-- ================= 小火箭 ================= -->


    <!-- ================= Galaxy ================= -->


    <!-- ================= DEPART ================= -->

    <ImageView
        android:id="@+id/imgRocket"
        android:layout_width="22dp"
        android:layout_height="42dp"
        android:layout_marginStart="112dp"
        android:layout_marginTop="128dp"
        android:contentDescription="Rocket"
        android:scaleType="fitCenter"
        android:src="@drawable/rocket_icon"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTraveller" />

    <ImageView
        android:id="@+id/imgGalaxy"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginStart="24dp"
        android:contentDescription="Galaxy"
        android:scaleType="fitCenter"
        android:src="@drawable/galaxy"

        app:layout_constraintBottom_toBottomOf="@id/imgRocket"
        app:layout_constraintStart_toEndOf="@id/imgRocket"
        app:layout_constraintTop_toTopOf="@id/imgRocket"
        app:layout_constraintVertical_bias="0.48" />

    <TextView
        android:id="@+id/btnDepart"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:background="#2E7D32"
        android:gravity="center"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>